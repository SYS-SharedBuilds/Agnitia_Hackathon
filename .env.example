# Environment variables for SwitchOn

# Mode: demo compresses retry intervals (1s initial, backoff 2x, max 8s)
DEMO_MODE=true
AUTH_DISABLED=true
API_KEY=switchon-secret-dev-key

# Service URLs
ORDER_API_URL=http://localhost:8000
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/switchon

# Mock URLs
OMS_MOCK_URL=http://localhost:8101
INVENTORY_MOCK_URL=http://localhost:8102
NETWORK_MOCK_URL=http://localhost:8103
BILLING_MOCK_URL=http://localhost:8104
NOTIFICATION_MOCK_URL=http://localhost:8105

# Console
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TEMPORAL_UI_URL=http://localhost:8233
